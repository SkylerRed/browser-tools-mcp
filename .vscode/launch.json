{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Program",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "runtimeExecutable": "${execPath}",
            "sourceMaps": true,
            "preLaunchTask": "${defaultBuildTask}",
            "restart": true,
            "outFiles": [
                "${workspaceFolder}/packages/**/dist/*.(m|c|)js",
                "!**/node_modules/**"
            ],
            "env": {
                "NODE_ENV": "development",
                "VSCODE_DEBUG_MODE": "true",
            },
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**"
            ],
            "presentation": {
                "hidden": false,
                "group": "tasks",
                "order": 1
            }
        },
        {
            "name": "Debug: Browser Tools - Server (Attach Specific)",
            "type": "node",
            "request": "attach",
            "port": 9230,
            "address": "localhost",
            "restart": true,
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/packages/browser-tools-server/dist/**/*.js"
            ],
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ],
            "presentation": {
                "hidden": false,
                "group": "Browser Tools Debug",
                "order": 2
            }
        },
        {
            "name": "Debug: Browser Tools - MCP (Attach Specific)",
            "type": "node",
            "request": "attach",
            "port": 9229,
            "address": "localhost",
            "restart": true,
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/packages/browser-tools-mcp/dist/**/*.js"
            ],
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ],
            "presentation": {
                "hidden": false,
                "group": "Browser Tools Debug",
                "order": 3
            }
        },
        {
            "name": "Attach: Browser Tools - MCP (Attach Specific)",
            "request": "attach",
            "type": "node",
            "port": 9231,
            "address": "localhost",
            "restart": true,
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/packages/browser-mcp/dist/**/*.js"
            ],
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ],
        }
    ]
}